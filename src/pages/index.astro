---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const posts = allPosts
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);

const catLabel: Record<string, string> = {
  python: 'Python', r: 'R', both: 'Python + R', reading: 'Reading Corner', personal: 'Personal',
};

const socials = [
  { label: 'GitHub', href: 'https://github.com/masbahnana', icon: 'github' },
  { label: 'LinkedIn', href: 'https://linkedin.com/in/nanadasilva', icon: 'linkedin' },
  { label: 'Instagram', href: 'https://instagram.com/atnanaverse', icon: 'instagram' },
];
---
<Layout title="NanaLab — Data meets animal science">
  <section class="hero">
    <div class="hero-eyebrow">Bioscience × Data Science</div>
    <h1>Hi, I'm Nana.<br/><span class="highlight">Data</span> meets<br/>animal science.</h1>

    <div class="hero-bio">
      <div class="hero-text">
        <p>I'm a <strong>Bioveterinary Science student</strong> with a background in IT. NanaLab is where I document my journey learning data analysis applied to biology — comparing <strong>R and Python</strong> side by side, using real public datasets.</p>
        <p>No gatekeeping. No pretending I know everything. Just honest exploration of data, biology, and everything in between. 🔬</p>
        <div class="hero-btns">
          <a href="/blog" class="btn-primary">Read the blog</a>
          <a href="https://pethology.app" target="_blank" rel="noopener" class="btn-ghost">Pethology ↗</a>
        </div>
        <div class="socials">
          {socials.map(s => (
            <a href={s.href} target="_blank" rel="noopener" class="social-link" aria-label={s.label}>
              {s.icon === 'github' && (
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844a9.59 9.59 0 012.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/></svg>
              )}
              {s.icon === 'linkedin' && (
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
              )}
              {s.icon === 'instagram' && (
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
              )}
            </a>
          ))}
        </div>
      </div>
      <div class="hero-stats">
        <div class="stat">
          <div class="stat-number">R + 🐍</div>
          <div class="stat-label">Side by side</div>
        </div>
        <div class="stat">
          <div class="stat-number">🧬</div>
          <div class="stat-label">Bio datasets</div>
        </div>
        <div class="stat">
          <div class="stat-number">GBIF</div>
          <div class="stat-label">Open datasets</div>
        </div>
      </div>
      <div class="hero-photo">
        <img src="/nana.jpg" alt="Nana" />
      </div>
    </div>
  </section>

  <div class="section-divider"></div>

  <section class="latest">
    <div class="section-header">
      <h2>Latest posts</h2>
      <a href="/blog" class="see-all">View all →</a>
    </div>
    <div class="posts-list">
      {posts.map(post => (
        <a href={`/blog/${post.id}`} class="post-row">
          <span class={`post-row-cat cat-${post.data.category}`}>{catLabel[post.data.category]}</span>
          <div class="post-row-content">
            <div class="post-row-title">{post.data.title}</div>
            <div class="post-row-desc">{post.data.description}</div>
          </div>
          <span class="post-row-date">
            {post.data.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}
          </span>
        </a>
      ))}
    </div>
  </section>
</Layout>

<style>
  .hero-photo {
    flex-shrink: 0;
    width: 200px;
    height: 240px;
  }

  .hero-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 14px;
    border: 3px solid var(--lime);
  }

  /* HERO */
  .hero {
    padding: 88px 48px 72px;
    max-width: 860px;
    margin: 0 auto;
  }

  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: var(--lime-dark);
    margin-bottom: 28px;
    animation: fadeUp 0.45s ease both;
  }

  .hero-eyebrow::before {
    content: '';
    display: inline-block;
    width: 24px;
    height: 2px;
    background: var(--lime);
  }

  h1 {
    font-family: 'Syne', sans-serif;
    font-weight: 800;
    font-size: clamp(2.6rem, 5.5vw, 4.2rem);
    line-height: 1.08;
    letter-spacing: -2px;
    margin-bottom: 24px;
    animation: fadeUp 0.45s ease 0.08s both;
  }

  h1 .highlight {
    background: var(--lime);
    padding: 0 8px;
    border-radius: 4px;
  }

  .hero-bio {
    display: flex;
    gap: 48px;
    align-items: flex-start;
    margin-top: 40px;
    animation: fadeUp 0.45s ease 0.16s both;
  }

  .hero-text { flex: 1; }

  .hero-text p {
    font-size: 1.05rem;
    color: var(--gray);
    line-height: 1.8;
    font-weight: 300;
    max-width: 480px;
  }

  .hero-text p + p { margin-top: 16px; }

  .hero-text p strong {
    color: var(--black);
    font-weight: 500;
  }

  .hero-stats {
    display: flex;
    flex-direction: column;
    gap: 24px;
    min-width: 160px;
  }

  .stat {
    border-left: 3px solid var(--lime);
    padding-left: 16px;
  }

  .stat-number {
    font-family: 'Syne', sans-serif;
    font-weight: 800;
    font-size: 1.5rem;
    letter-spacing: -1px;
    line-height: 1;
    margin-bottom: 4px;
  }

  .stat-label {
    font-size: 0.72rem;
    color: var(--gray);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.8px;
  }

  .hero-btns {
    display: flex;
    gap: 12px;
    margin-top: 36px;
    flex-wrap: wrap;
    animation: fadeUp 0.45s ease 0.24s both;
  }

  .btn-primary {
    background: var(--black);
    color: var(--white);
    padding: 13px 26px;
    border-radius: 8px;
    font-family: 'DM Sans', sans-serif;
    font-weight: 500;
    font-size: 0.9rem;
    border: none;
    cursor: pointer;
    transition: background 0.2s, transform 0.15s;
    text-decoration: none;
    display: inline-block;
  }

  .btn-primary:hover { background: #222; transform: translateY(-1px); }

  .btn-ghost {
    background: transparent;
    color: var(--black);
    padding: 13px 26px;
    border-radius: 8px;
    font-family: 'DM Sans', sans-serif;
    font-weight: 500;
    font-size: 0.9rem;
    border: 1.5px solid var(--border);
    cursor: pointer;
    transition: border-color 0.2s, transform 0.15s;
    text-decoration: none;
    display: inline-block;
  }

  .btn-ghost:hover { border-color: #999; transform: translateY(-1px); }

  .socials {
    display: flex;
    gap: 12px;
    margin-top: 20px;
  }

  .social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 8px;
    border: 1.5px solid var(--border);
    color: var(--gray);
    text-decoration: none;
    transition: border-color 0.2s, color 0.2s, transform 0.15s;
  }

  .social-link:hover {
    border-color: var(--black);
    color: var(--black);
    transform: translateY(-1px);
  }

  /* DIVIDER */
  .section-divider {
    height: 1px;
    background: var(--border);
    max-width: 860px;
    margin: 0 auto;
  }

  /* LATEST POSTS */
  .latest {
    padding: 72px 48px;
    max-width: 860px;
    margin: 0 auto;
  }

  .section-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 36px;
  }

  .section-header h2 {
    font-family: 'Syne', sans-serif;
    font-weight: 700;
    font-size: 1.5rem;
    letter-spacing: -0.5px;
  }

  .see-all {
    font-size: 0.82rem;
    color: var(--gray);
    font-weight: 500;
    text-decoration: none;
    transition: color 0.2s;
  }

  .see-all:hover { color: var(--black); }

  .posts-list {
    display: flex;
    flex-direction: column;
    border: 1.5px solid var(--border);
    border-radius: 14px;
    overflow: hidden;
  }

  .post-row {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 22px 24px;
    background: var(--white);
    cursor: pointer;
    transition: background 0.15s;
    border-bottom: 1px solid var(--border);
    text-decoration: none;
    color: inherit;
  }

  .post-row:last-child { border-bottom: none; }
  .post-row:hover { background: var(--gray-light); }

  .post-row-cat {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 999px;
    white-space: nowrap;
    min-width: 84px;
    text-align: center;
  }

  .cat-python { background: #dbeafe; color: #1d4ed8; }
  .cat-r { background: #fce7f3; color: #9d174d; }
  .cat-both { background: var(--lime-soft); color: var(--lime-dark); }
  .cat-reading { background: #fef3c7; color: #92400e; }
  .cat-personal { background: #f3e8ff; color: #6b21a8; }

  .post-row-content { flex: 1; }

  .post-row-title {
    font-family: 'Syne', sans-serif;
    font-weight: 600;
    font-size: 0.95rem;
    letter-spacing: -0.2px;
    margin-bottom: 4px;
    color: var(--black);
  }

  .post-row-desc {
    font-size: 0.82rem;
    color: var(--gray);
    font-weight: 300;
    line-height: 1.5;
  }

  .post-row-date {
    font-size: 0.75rem;
    color: #bbb;
    white-space: nowrap;
  }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 640px) {
    .hero { padding: 60px 20px 48px; }
    .hero-bio { flex-direction: column; gap: 28px; }
    .hero-photo { width: 100%; height: 220px; }
    .hero-stats { flex-direction: row; flex-wrap: wrap; }
    .latest { padding: 48px 20px; }
    .post-row { flex-wrap: wrap; }
  }
</style>
